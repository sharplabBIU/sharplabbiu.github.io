<!-- Decorative side borders (wide screens only): four computational / RL objects per side, evenly spaced -->
{% assign border_left = 'bellman,decision-tree,dyna,bayes' | split: ',' %}
{% assign border_right = 'cognitive-map,task-representation,sr-matrix,q-learning' | split: ',' %}
<div class="side-border side-border-left" aria-hidden="true">
  {% for name in border_left %}
    {% capture border_src %}/assets/img/border/{{ name }}.svg{% endcapture %}
    <img src="{{ border_src | relative_url | bust_file_cache }}" alt="">
  {% endfor %}
</div>
<div class="side-border side-border-right" aria-hidden="true">
  {% for name in border_right %}
    {% capture border_src %}/assets/img/border/{{ name }}.svg{% endcapture %}
    <img src="{{ border_src | relative_url | bust_file_cache }}" alt="">
  {% endfor %}
</div>
