<!-- Lab news, newest first, under a heading for each year (no months or days), with a divider between the years, in a
box that scrolls (about three items show at a time) -->
<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news = news | slice: 0, site.announcements.limit %}
    {% endif %}
    {% assign years = news | group_by_exp: 'item', "item.date | date: '%Y'" %}
    <div class="news-scroll">
      {% for year in years %}
        <section class="news-year">
          <h3 class="news-year-title section-bar">{{ year.name }}</h3>
          {% for item in year.items %}
            <div class="news-item">
              {% if item.inline %}
                <p>{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</p>
              {% else %}
                <p><a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a></p>
              {% endif %}
            </div>
          {% endfor %}
        </section>
        {% unless forloop.last %}<hr class="news-divider">{% endunless %}
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
