{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0 footer-content{% if page.permalink == '/' %} bar-wide{% endif %}">
      <!-- Social icons, shown on every page -->
      <div class="footer-social">{% include social.liquid %}</div>
      <div class="footer-copyright">
        &copy; Copyright {{ site.time | date: '%Y' }}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}. {{ site.footer_text }}
        {% if site.impressum_path %}
          <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
        {% endif %}
        {% if site.last_updated %}
          Last updated: {{ 'now' | date: '%B %d, %Y' }}.
        {% endif %}
      </div>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom" role="contentinfo">
    <div class="container footer-content{% if page.permalink == '/' %} bar-wide{% endif %}">
      <!-- Social icons, shown on every page -->
      <div class="footer-social">{% include social.liquid %}</div>
      <div class="footer-copyright">
        &copy; Copyright {{ site.time | date: '%Y' }}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}. {{ site.footer_text }}
        {% if site.impressum_path %}
          <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
        {% endif %}
        {% if site.last_updated %}
          Last updated: {{ 'now' | date: '%B %d, %Y' }}.
        {% endif %}
      </div>
    </div>
  </footer>
{% endif %}
