---
layout: default
---
<div class="post">
  {% if page.collection == 'projects' or page.permalink == '/404.html' %}
    <!-- Member pages and the 404 page: all content in one card; other pages lay out their own cards -->
    <article class="content-card">
      {{ content }}
    </article>
  {% else %}
    <article>
      {{ content }}
    </article>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
