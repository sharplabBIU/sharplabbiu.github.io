---
layout: default
---
<div class="post">
  {% if page.subtitle %}
    <header class="post-header">
      <p class="desc">{{ page.subtitle }}</p>
    </header>
  {% endif %}

  <article>
    <!-- The description is split at the "world-model figure" marker in the page: the first paragraph goes above the graphic, the rest below it -->
    {% assign home_parts = content | split: '<!-- world-model figure -->' %}
    <div class="home-lead">
      <div class="home-intro">{{ home_parts[0] }}</div>
    </div>

    <!-- The clickable world-model graphic -->
    {% if page.world_model_figure %}
      {% include world_model.liquid %}
      <script src="{{ '/assets/js/world-model.js' | relative_url | bust_file_cache }}" defer></script>
    {% endif %}

    {% if home_parts.size > 1 %}
      <div class="home-intro">{{ home_parts[1] }}</div>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <div class="home-news">
        <h2>lab news</h2>
        {% include news.liquid limit=true %}
      </div>
    {% endif %}

    <!-- Embedded YouTube video (shown after the news) -->
    {% if page.video %}
      <div class="home-video">
        {% if page.video.heading %}
          <h4>{{ page.video.heading }}</h4>
        {% endif %}
        <div class="video-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/{{ page.video.youtube_id }}"
            title="{{ page.video.title }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div>
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
